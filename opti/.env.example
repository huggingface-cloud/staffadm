# Environment Variables for Roster Optimizer

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Next.js Configuration (for API route)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optimizer API Configuration
OPTIMIZER_API_URL=http://localhost:8000
PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://your-nextjs-app.vercel.app

# Solver Configuration (optional)
USE_GUROBI=false
GUROBI_LICENSE_FILE=/path/to/gurobi.lic
